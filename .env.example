# PostgreSQL 帳號密碼（給 docker-compose 啟動的 Postgres 容器使用）
DB_USERNAME=
DB_PASSWORD=

# S3 相容物件儲存設定 (B2 / R2 通用)，用於教材原始檔上傳/下載
S3_ENDPOINT=       # 物件儲存服務的 API 端點，例如 https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY=     # 物件儲存的 Access Key ID
S3_SECRET_KEY=     # 物件儲存的 Secret Access Key
S3_BUCKET_NAME=    # 存放教材檔案的 bucket 名稱
S3_PUBLIC_URL=     # 檔案對外公開存取的網域（例如自訂 CDN 網域），留空則以 S3_ENDPOINT 組出的預設網址存取

# Google Gemini API Key，AI Service 呼叫 LLM／Embedding 時使用
GEMINI_API_KEY=

# OAuth2 第三方登入設定，各平台皆需自行申請 OAuth App 取得 Client ID / Secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# JWT Secret Key (本地開發用 HS256 金鑰，建議自行產生亂數字串，長度至少 32 bytes)
JWT_SECRET_KEY=

# CORS 白名單設定，多個來源以逗號分隔，例如 http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Seata 分散式事務服務位址，格式為 host:port，本地開發預設 localhost:8091
SEATA_SERVER_ADDR=
